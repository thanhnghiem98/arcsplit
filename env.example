# ArcSplit environment variables
# Copy this file to .env and fill in the values.

# Deployed ArcSplit contract address on Arc Mainnet (set after deploying contracts/ArcSplit.sol)
VITE_ARCSPLIT_ADDRESS=0xYOUR_DEPLOYED_CONTRACT_ADDRESS

# RPC proxy variables (provided automatically by Arc Studio — optional outside Arc Studio)
# RPC_PROXY_BASE_URL=
# RPC_PROXY_TOKEN=
# RPC_PROXY_CHAINS=Arc_Testnet,Arc
